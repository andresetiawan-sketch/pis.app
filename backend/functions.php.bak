<?php
if (!defined('PIS_APP')) { http_response_code(403); exit('Forbidden'); }
require_once __DIR__ . '/entities.php';
require_once __DIR__ . '/auth.php';

// ── employeeLogin — login pakai NIK + password terhadap entity Employee ──
function fn_employee_login(array $body): array {
    $nik = $body['nik'] ?? null;
    $password = $body['password'] ?? null;
    if (!$nik || !$password) return ['success' => false, 'error' => 'NIK dan password wajib diisi'];

    if (is_login_locked($nik)) {
        $min = (int) round(LOGIN_LOCK_SECONDS / 60);
        return ['success' => false, 'error' => "Terlalu banyak percobaan gagal. Coba lagi dalam $min menit."];
    }

    $emp = find_employee_by_nik($nik);
    if (!$emp) { register_login_failure($nik); return ['success' => false, 'error' => 'NIK tidak ditemukan']; }
    if ((string)($emp['password'] ?? '') !== (string)$password) {
        register_login_failure($nik);
        return ['success' => false, 'error' => 'Password salah'];
    }
    if (!empty($emp['status_aktif']) && $emp['status_aktif'] !== 'Aktif') {
        return ['success' => false, 'error' => 'Akun tidak aktif'];
    }

    clear_login_failure($nik);
    $token = create_session([
        'sub' => $emp['id'], 'nik' => $emp['nik_karyawan'], 'role' => $emp['role'] ?? 'Staff',
        'nama' => $emp['nama_lengkap'] ?? '', 'area_tugas' => $emp['area_tugas'] ?? '', 'jabatan' => $emp['jabatan'] ?? '',
    ]);
    unset($emp['password']);
    return ['success' => true, 'employee' => $emp, 'token' => $token];
}

function fn_employee_logout(array $body): array {
    if (!empty($body['token'])) revoke_session($body['token']);
    return ['success' => true];
}

function fn_employee_reset_password(array $body): array {
    $nik = $body['nik'] ?? null;
    $newPassword = $body['newPassword'] ?? null;
    if (!$nik || !$newPassword) return ['success' => false, 'error' => 'NIK dan password baru wajib diisi'];
    $emp = find_employee_by_nik($nik);
    if (!$emp) return ['success' => false, 'error' => 'NIK tidak ditemukan'];
    update_entity('Employee', $emp['id'], ['password' => $newPassword]);
    return ['success' => true, 'message' => 'Password berhasil diubah'];
}

function fn_get_employee_by_nik(array $body): array {
    $nik = $body['nik'] ?? null;
    if (!$nik) return ['success' => false, 'error' => 'NIK wajib diisi'];
    $emp = find_employee_by_nik($nik);
    if (!$emp) return ['success' => false, 'error' => 'NIK tidak ditemukan'];
    unset($emp['password']);
    return ['success' => true, 'employee' => $emp];
}

// ── createMasterAdmin — hanya Master Admin yang boleh menambah Master Admin lain ──
function fn_create_master_admin(array $body, ?array $auth): array {
    if (!is_master_admin($auth)) return ['success' => false, 'error' => 'Hanya Master Admin yang bisa menambah Master Admin baru'];
    $nik = $body['nik_karyawan'] ?? null;
    $nama = $body['nama_lengkap'] ?? null;
    $password = $body['password'] ?? null;
    if (!$nik || !$nama || !$password) return ['success' => false, 'error' => 'nik_karyawan, nama_lengkap, dan password wajib diisi'];
    if (!check_nik_unique((string)$nik)) return ['success' => false, 'error' => "NIK \"$nik\" sudah terdaftar"];

    $empData = [
        'nik_karyawan' => $nik, 'nama_lengkap' => $nama, 'password' => $password,
        'role' => 'Master Admin', 'jabatan' => $body['jabatan'] ?? 'Administrator',
        'area_tugas' => $body['area_tugas'] ?? 'Head Office', 'email' => $body['email'] ?? '',
        'status_aktif' => 'Aktif', 'dibuat_oleh_admin' => $auth['nik'] ?? '',
    ];
    $newEmp = create_entity('Employee', $empData, $auth['nik'] ?? null);
    unset($newEmp['password']);
    return ['success' => true, 'employee' => $newEmp, 'message' => 'Master Admin berhasil dibuat'];
}

// ── Menu admin per role (setAdminMenu/getAdminMenu) ──
function get_setting(string $key): string {
    $stmt = db()->prepare('SELECT setting_value FROM settings WHERE setting_key = ? LIMIT 1');
    $stmt->execute([$key]);
    $row = $stmt->fetch();
    return $row ? (string)$row['setting_value'] : '';
}
function set_setting(string $key, string $value): void {
    $stmt = db()->prepare('INSERT INTO settings (setting_key, setting_value) VALUES (?, ?) ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)');
    $stmt->execute([$key, $value]);
}

function fn_set_admin_menu(array $body, ?array $auth): array {
    if (!is_master_admin($auth)) return ['success' => false, 'error' => 'Hanya Master Admin yang bisa mengatur menu'];
    $role = $body['role'] ?? null;
    $menu = $body['menu'] ?? [];
    if (!$role) return ['success' => false, 'error' => 'role wajib diisi'];
    set_setting("menu_config:$role", json_encode($menu));
    return ['success' => true];
}
function fn_get_admin_menu(array $body): array {
    $role = $body['role'] ?? 'Staff';
    $raw = get_setting("menu_config:$role");
    return ['success' => true, 'menu' => $raw ? json_decode($raw, true) : []];
}

// ── Aturan notifikasi (setNotificationRules/getNotificationRules) ──
function fn_set_notification_rules(array $body, ?array $auth): array {
    if (!is_admin($auth)) return ['success' => false, 'error' => 'Hanya Admin/Master Admin yang bisa mengatur notifikasi'];
    set_setting('notification_rules', json_encode($body['rules'] ?? []));
    return ['success' => true];
}
function fn_get_notification_rules(): array {
    $raw = get_setting('notification_rules');
    return ['success' => true, 'rules' => $raw ? json_decode($raw, true) : []];
}
function fn_get_notification_sounds(): array {
    $raw = get_setting('notification_sounds');
    return ['success' => true, 'sounds' => $raw ? json_decode($raw, true) : []];
}
function fn_set_notification_sounds(array $body, ?array $auth): array {
    if (!is_admin($auth)) return ['success' => false, 'error' => 'Hanya Admin/Master Admin yang bisa mengatur bunyi notifikasi'];
    set_setting('notification_sounds', json_encode($body['sounds'] ?? []));
    return ['success' => true];
}

// ── Notifikasi personal (SystemNotification entity) ──
function fn_get_my_notifications(array $body, ?array $auth): array {
    if (!$auth) return ['success' => false, 'error' => 'Sesi login tidak valid'];
    $list = list_entity('SystemNotification', ['nik_tujuan' => $auth['nik'], 'sort' => '-created_date', 'limit' => 100]);
    return ['success' => true, 'notifications' => $list];
}
function fn_mark_notification_read(array $body): array {
    $id = $body['id'] ?? null;
    if (!$id) return ['success' => false, 'error' => 'id wajib diisi'];
    update_entity('SystemNotification', $id, ['sudah_dibaca' => true]);
    return ['success' => true];
}

